rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public read on members for verification and card lookup
    match /members/{memberId} {
      allow read: if true;
      allow write: if request.auth != null || true; // flexible for portal submission & admin dashboard
    }
    
    // Applications submitted by prospective members
    match /applications/{appId} {
      allow create: if true;
      allow read, update, delete: if true;
    }

    // Admin records
    match /admins/{adminId} {
      allow read, write: if true;
    }

    // Default fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
